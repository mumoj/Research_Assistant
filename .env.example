GEMINI_API_KEY=foo
YOUTUBE_API_KEY=bar
SerpAPI_KEY=foobar
GROQ_API_KEY=baz

# Optional: pin the Gemini model. Leave unset to auto-select the best model
# the API key can call (the app queries ListModels once per process).
# GEMINI_MODEL=gemini-3.8-flash

# Validation Configuration
# VALIDATOR_PROVIDER is a preference, not a requirement: if its API key is
# missing, the app falls back to any other configured FREE-tier provider, and
# skips validation entirely if none are set. Groq and Gemini are free; OpenAI
# and Anthropic bill from the first request and are only ever used when named
# here explicitly.
ENABLE_VALIDATION=true
VALIDATOR_PROVIDER=groq
VALIDATOR_MODEL=openai/gpt-oss-120b
CONFIDENCE_THRESHOLD=80
