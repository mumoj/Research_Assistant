GEMINI_API_KEY=foo
YOUTUBE_API_KEY=bar
SerpAPI_KEY=foobar
GROQ_API_KEY=baz

# Optional: pin the Gemini model. Leave unset to auto-select the best model
# the API key can call (the app queries ListModels once per process).
# GEMINI_MODEL=gemini-3.8-flash

# Answer generation provider. Same rules as VALIDATOR_PROVIDER below: a
# preference, honoured only if its key is set, free tiers auto-detected first
# (groq, then gemini) and paid ones used only when named here.
# Groq answers the same prompt in ~2s where a Gemini thinking model takes ~80s,
# so leaving this unset on a deployment with both keys picks Groq.
# PRIMARY_PROVIDER=groq
# PRIMARY_MODEL=openai/gpt-oss-120b

# How many output tokens Gemini may spend reasoning before it starts writing.
# Default 0. Gemini 3.x otherwise spent ~1436 of its 1500-token budget thinking
# and hit MAX_TOKENS mid-thought, so the answer came back truncated or empty.
# Raise it to trade latency for reasoning depth; -1 lets the model decide.
# GEMINI_THINKING_BUDGET=0

# Validation Configuration
# VALIDATOR_PROVIDER is a preference, not a requirement: if its API key is
# missing, the app falls back to any other configured FREE-tier provider, and
# skips validation entirely if none are set. Groq and Gemini are free; OpenAI
# and Anthropic bill from the first request and are only ever used when named
# here explicitly.
ENABLE_VALIDATION=true
# Prefer a different model from PRIMARY_MODEL, so validation is a second
# opinion rather than the answering model reviewing its own work.
VALIDATOR_PROVIDER=groq
VALIDATOR_MODEL=openai/gpt-oss-20b
CONFIDENCE_THRESHOLD=80
